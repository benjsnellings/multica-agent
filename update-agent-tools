#!/usr/bin/env bash
# Keep Claude Code, Cursor Agent, and Pi CLIs current.
# Intended for the background tool-updater service — not cont-init (too slow for boot).
# Failures are logged, not fatal. Each step is time-bounded so a hang cannot block forever.
set -u

log() { echo "[tool-updater] $*"; }

ARCH_RAW="$(uname -m)"
case "${ARCH_RAW}" in
  x86_64|amd64) CLAUDE_PLATFORM="linux-x64"; CURSOR_ARCH="x64" ;;
  aarch64|arm64) CLAUDE_PLATFORM="linux-arm64"; CURSOR_ARCH="arm64" ;;
  *) log "unsupported arch ${ARCH_RAW}"; exit 0 ;;
esac

mkdir -p /data/bin /data/.local/bin /data/.local/share /usr/local/bin \
  /data/.npm /data/.cache

# Bound network/install steps so Supervisor never sees a stuck boot/service.
# Exit 124 from GNU timeout means the deadline was hit.
run_timeout() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=30s "${secs}" "$@"
    return $?
  fi
  "$@"
  return $?
}

explain_rc() {
  local rc="$1"
  case "${rc}" in
    0) echo "ok" ;;
    124) echo "timed out (GNU timeout exit 124)" ;;
    137) echo "killed SIGKILL (often OOM or kill-after)" ;;
    143) echo "terminated SIGTERM" ;;
    *) echo "exit ${rc}" ;;
  esac
}

log_df() {
  local line
  while IFS= read -r line; do
    log "df: ${line}"
  done < <(df -h /data / /usr/local 2>/dev/null || df -h /data / 2>/dev/null || true)
}

tail_npm_log() {
  local latest lines
  latest="$(ls -t /data/.npm/_logs/*-debug-*.log 2>/dev/null | head -1 || true)"
  if [[ -z "${latest}" ]]; then
    log "no npm debug log under /data/.npm/_logs"
    return 0
  fi
  log "npm debug log: ${latest}"
  lines="$(tail -n 60 "${latest}" 2>/dev/null || true)"
  if [[ -n "${lines}" ]]; then
    log "----- npm log tail -----"
    while IFS= read -r line; do
      log "npm: ${line}"
    done <<<"${lines}"
    log "----- end npm log -----"
  fi
}

update_claude() {
  log "Updating Claude Code to latest…"
  local version checksum url tmp rc
  version="$(run_timeout 60 curl -fsSL https://downloads.claude.ai/claude-code-releases/latest)" || {
    log "could not resolve Claude latest version"; return 0
  }
  checksum="$(run_timeout 60 curl -fsSL "https://downloads.claude.ai/claude-code-releases/${version}/manifest.json" \
    | jq -r --arg p "${CLAUDE_PLATFORM}" '.platforms[$p].checksum // empty')" || true
  if [[ -z "${checksum}" ]]; then
    log "no Claude checksum for ${CLAUDE_PLATFORM} in ${version}"; return 0
  fi
  tmp="$(mktemp)"
  url="https://downloads.claude.ai/claude-code-releases/${version}/${CLAUDE_PLATFORM}/claude"
  if ! run_timeout 120 curl -fsSL "${url}" -o "${tmp}"; then
    log "Claude download failed"; rm -f "${tmp}"; return 0
  fi
  if ! echo "${checksum}  ${tmp}" | sha256sum -c -; then
    log "Claude checksum mismatch"; rm -f "${tmp}"; return 0
  fi
  install -m 0755 "${tmp}" /data/bin/claude
  install -m 0755 "${tmp}" /usr/local/bin/claude
  rm -f "${tmp}"
  log "Claude Code ${version} installed ($(claude --version 2>/dev/null || true))"
}

update_cursor() {
  log "Updating Cursor Agent…"
  # Official installer places agent under $HOME/.local; use /data so it persists.
  local old_home="${HOME:-}" rc
  export HOME=/data
  run_timeout 180 bash -c 'curl -fsS https://cursor.com/install | bash'
  rc=$?
  if [[ "${rc}" -eq 0 ]]; then
    if [[ -x /data/.local/bin/cursor-agent ]]; then
      ln -sfn /data/.local/bin/cursor-agent /data/bin/cursor-agent
      ln -sfn /data/.local/bin/agent /data/bin/agent
      ln -sfn /data/.local/bin/cursor-agent /usr/local/bin/cursor-agent
      ln -sfn /data/.local/bin/agent /usr/local/bin/agent
    fi
    log "Cursor Agent updated ($(cursor-agent --version 2>/dev/null || agent --version 2>/dev/null || echo unknown))"
  else
    log "Cursor Agent update failed ($(explain_rc "${rc}")) (non-fatal)"
  fi
  export HOME="${old_home}"
}

pi_installed_version() {
  npm ls -g --depth=0 --json @earendil-works/pi-coding-agent 2>/dev/null \
    | jq -r '.dependencies["@earendil-works/pi-coding-agent"].version // empty'
}

update_pi() {
  log "Updating Pi coding agent…"
  if ! command -v npm >/dev/null; then
    log "npm missing; skip Pi update"; return 0
  fi
  export npm_config_cache=/data/.npm
  export npm_config_update_notifier=false
  export npm_config_fund=false
  export npm_config_audit=false
  # Stream useful progress into the add-on log (HA captures stdout/stderr).
  export npm_config_loglevel="${NPM_LOGLEVEL:-info}"

  local installed latest rc started elapsed
  log "node=$(node -v 2>/dev/null || echo missing) npm=$(npm -v 2>/dev/null || echo missing) arch=${ARCH_RAW}"
  log_df

  installed="$(pi_installed_version || true)"
  latest="$(run_timeout 60 npm view @earendil-works/pi-coding-agent version 2>/dev/null || true)"
  log "Pi installed=${installed:-none} latest=${latest:-unknown}"

  if [[ -z "${latest}" ]]; then
    log "could not resolve latest Pi version from npm registry (network/DNS?)"
    run_timeout 15 curl -fsSI https://registry.npmjs.org/@earendil-works/pi-coding-agent >/dev/null \
      && log "npm registry HEAD ok" \
      || log "npm registry HEAD failed"
    return 0
  fi

  if [[ -n "${installed}" && "${installed}" == "${latest}" ]]; then
    log "Pi already at ${installed}; skip npm install"
    if command -v pi >/dev/null; then
      ln -sfn "$(command -v pi)" /data/bin/pi 2>/dev/null || true
    fi
    return 0
  fi

  # Full npm tree is large (~13MB + deps); keep a generous bound and explain failures.
  log "Pi ${installed:-none} → ${latest} (npm install, timeout 900s)…"
  started="$(date +%s)"
  run_timeout 900 npm install -g --omit=dev --no-audit --no-fund \
    @earendil-works/pi-coding-agent@latest
  rc=$?
  elapsed="$(( $(date +%s) - started ))"
  log "Pi npm install finished after ${elapsed}s ($(explain_rc "${rc}"))"

  if [[ "${rc}" -eq 0 ]]; then
    if command -v pi >/dev/null; then
      ln -sfn "$(command -v pi)" /data/bin/pi 2>/dev/null || true
    fi
    log "Pi updated ($(pi --version 2>/dev/null || echo unknown))"
    return 0
  fi

  log "Pi update failed (non-fatal); image-seeded pi remains available"
  log_df
  tail_npm_log
}

update_claude
update_cursor
update_pi
log "done"
